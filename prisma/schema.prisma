generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPERVISOR
  SALES_REP
  DRIVER
  CASHIER
  BRANCH_MANAGER
  HQ_MANAGER
  ACCOUNT_MANAGER
  STOREKEEPER
  DIRECTOR
}

enum VehicleStatus {
  ACTIVE
  IN_GARAGE
  MAINTENANCE
  RETIRED
}

enum InspectionType {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReturnReason {
  WRONG_ITEM
  MISSING_ITEM
  CANCELLED_ORDER
  DAMAGED
  EXPIRED
}

enum DeliveryStatus {
  DELIVERED
  PARTIAL
  FAILED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIAL
}

enum AssignmentDayType {
  ORDER_TAKING
  DELIVERY
}

enum ShiftType {
  ONSITE
  OFFSITE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  role          UserRole
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  salesRep      SalesRep?
  driver        Driver?

  supervisedSalesReps  SalesRep[]  @relation("SupervisorSalesRep")
  supervisedDrivers    Driver[]    @relation("SupervisorDriver")
  groupSupervised      RouteGroup? @relation("GroupSupervisor")

  blockedBlockEvents    AccountBlockEvent[]   @relation("BlockEventCashier")
  reviewedRequests      AccountUnblockRequest[] @relation("ReviewRequestCashier")
  acknowledgedAlerts    AccountAlert[]        @relation("AlertCashier")
  requestedUnblockReqs  AccountUnblockRequest[] @relation("RequestByRep")

  @@map("users")
}

model RouteGroup {
  id           String   @id @default(cuid())
  name         String   @unique
  supervisorId String   @unique
  createdAt    DateTime @default(now())

  supervisor User    @relation("GroupSupervisor", fields: [supervisorId], references: [id])
  routes     Route[]


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("route_groups")
}

model Route {
  id            String    @id @default(cuid())
  name          String    @unique
  mileageBefore Float     @default(0)
  mileageAfter  Float     @default(0)
  targetDaily   Float     @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  groupId          String?
  tonnage          Float?
  orderTakingDays  Json    @default("[]")
  deliveryDays     Json    @default("[]")
  shiftType        ShiftType @default(ONSITE)
  tatHours         Float?
  targetCustomers  Int?
  defaultVehicleId String?

  group              RouteGroup?  @relation(fields: [groupId], references: [id])
  defaultVehicle     Vehicle?     @relation(fields: [defaultVehicleId], references: [id])
  assignments        DailyAssignment[]
  missingItems       MissingItem[]
  pricingSurveys     PricingSurvey[]
  salesRepRoutes     SalesRepRoute[]
  creditSales        CreditSale[]
  weeklyProfitabilitySnapshots WeeklyProfitabilitySnapshot[]


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([defaultVehicleId])
  @@map("routes")
}

model SalesRep {
  id           String    @id @default(cuid())
  userId       String    @unique
  name         String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  supervisorId String?

  supervisor   User?     @relation("SupervisorSalesRep", fields: [supervisorId], references: [id])

  assignments       DailyAssignment[]
  pricingSurveys    PricingSurvey[]
  routes            SalesRepRoute[]
  cashierAccount    CashierAccount?


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([supervisorId])
  @@map("sales_reps")
}

model SalesRepRoute {
  id          String  @id @default(cuid())
  salesRepId  String
  routeId     String
  salesRep    SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([salesRepId, routeId])
  @@map("sales_rep_routes")
}

model Driver {
  id           String    @id @default(cuid())
  userId       String    @unique
  name         String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  supervisorId String?

  supervisor   User?     @relation("SupervisorDriver", fields: [supervisorId], references: [id])

  assignments       DailyAssignment[]


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([supervisorId])
  @@map("drivers")
}

model Vehicle {
  id                    String        @id @default(cuid())
  registration          String        @unique
  status                VehicleStatus @default(ACTIVE)
  maintenanceRatePerKm  Float?
  tonnageCapacity       Float?
  createdAt             DateTime      @default(now())

  assignments       DailyAssignment[]
  inspections       VehicleInspection[]
  fleetDaily        FleetDaily[]
  fixedCosts        VehicleFixedCost[]
  maintenanceEvents VehicleMaintenanceEvent[]
  defaultForRoutes  Route[]


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}

model VehicleFixedCost {
  id          String    @id @default(cuid())
  vehicleId   String
  name        String    // "Insurance" | "Road License" | "Lease" | "GPS Tracking" | "Other"
  amount      Float
  frequency   String    @default("monthly") // "monthly" | "quarterly" | "annual"
  dueDate     DateTime?
  paid        Boolean   @default(false)
  paidDate    DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@map("vehicle_fixed_costs")
}

model VehicleMaintenanceEvent {
  id            String    @id @default(cuid())
  vehicleId     String
  date          DateTime  @db.Date
  type          String    // "service" | "repair" | "tyre" | "battery" | "other"
  description   String
  cost          Float
  mileageAtEvent Float?
  vendor        String?
  invoiceRef    String?
  notes         String?
  createdAt     DateTime  @default(now())

  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([date])
  @@map("vehicle_maintenance_events")
}

model PayrollCost {
  id          String    @id @default(cuid())
  role        String    // "DRIVER" | "SALES_REP" | "CASHIER" | "SUPERVISOR" | "ADMIN"
  staffName   String?
  month       String    // "2026-07"
  basicPay    Float
  allowance   Float     @default(0)
  deductions  Float     @default(0)
  netPay      Float
  paid        Boolean   @default(false)
  paidDate    DateTime?
  notes       String?
  createdAt   DateTime  @default(now())


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([month])
  @@map("payroll_costs")
}

model SkuCatalog {
  id                String    @id @default(cuid())
  name              String
  category          String?
  unitPrice         Float
  unitType          String    @default("piece")
  packSize          String?
  unitWeightKg      Float?
  costPrice         Float?
  listSellingPrice  Float?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  orderLines        OrderLine[]
  missingItems      MissingItem[]
  returns           Return[]
  pricingSurveys    PricingSurvey[]
  inventoryCounts   InventoryCount[]


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("sku_catalog")
}

model DailyAssignment {
  id            String            @id @default(cuid())
  date          DateTime          @db.Date
  dayType       AssignmentDayType @default(DELIVERY)
  routeId       String
  salesRepId    String?
  driverId      String?
  vehicleId     String?
  status        AssignmentStatus  @default(PENDING)
  createdAt     DateTime          @default(now())

  route         Route             @relation(fields: [routeId], references: [id])
  salesRep      SalesRep?         @relation(fields: [salesRepId], references: [id])
  driver        Driver?           @relation(fields: [driverId], references: [id])
  vehicle       Vehicle?          @relation(fields: [vehicleId], references: [id])

  salesRepShift SalesRepShift?
  driverShift   DriverShift?
  orders        Order[]
  missingItems  MissingItem[]


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([date, routeId])
  @@index([date])
  @@index([salesRepId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@map("daily_assignments")
}

model SalesRepShift {
  id                    String    @id @default(cuid())
  assignmentId          String    @unique
  shiftOpen             DateTime?
  shiftClose            DateTime?
  shiftOpenTarget       DateTime?
  shiftCloseTarget      DateTime?
  customerCountTarget   Int       @default(0)
  customerCountActual   Int       @default(0)
  salesTarget           Float     @default(0)
  salesActual           Float     @default(0)
  tonnageTarget         Float?
  tonnageActual         Float?
  complaints            Int       @default(0)
  complaintTarget       Int       @default(0)
  reportSubmissionTime  DateTime?
  comments              String?
  kpiReasons            Json      @default("{}")
  createdAt             DateTime  @default(now())

  assignment            DailyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("sales_rep_shifts")
}

model DriverShift {
  id                  String    @id @default(cuid())
  assignmentId        String    @unique
  loadingStart        DateTime?
  loadingEnd          DateTime?
  loadingStartTarget  DateTime?
  loadingEndTarget    DateTime?
  shiftStart          DateTime?
  gatePassTime        DateTime?
  shiftEnd            DateTime?
  fuelCost            Float?
  fuelLiters          Float?
  mileageCovered      Float?
  customerCountActual Int       @default(0)
  targetCustomers     Int?
  customersWithOtp    Int?
  customersWithoutOtp Int?
  cashCollectionTarget Float?
  cashCollectionActual Float?
  pendingCollection   Float?
  loadingCheck        Boolean?
  reportSubmissionTime DateTime?
  comments            String?
  createdAt           DateTime  @default(now())

  assignment          DailyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  deliveryStops       DeliveryStop[]
  returns             Return[]


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("driver_shifts")
}

model Order {
  id            String    @id @default(cuid())
  assignmentId  String
  customerName  String
  totalAmount   Float     @default(0)
  createdAt     DateTime  @default(now())

  assignment    DailyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  lines         OrderLine[]
  deliveryStop  DeliveryStop?


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([assignmentId])
  @@index([customerName])
  @@map("orders")
}

model OrderLine {
  id        String    @id @default(cuid())
  orderId   String
  skuId     String
  quantity  Int       @default(0)
  unitPrice Float
  amount    Float     @default(0)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku       SkuCatalog @relation(fields: [skuId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("order_lines")
}

model DeliveryStop {
  id          String          @id @default(cuid())
  orderId     String          @unique
  driverShiftId String
  status      DeliveryStatus  @default(DELIVERED)
  reason      String?
  timestamp   DateTime        @default(now())

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverShift DriverShift     @relation(fields: [driverShiftId], references: [id], onDelete: Cascade)


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("delivery_stops")
}

model MissingItem {
  id                    String    @id @default(cuid())
  assignmentId          String
  skuId                 String
  routeId               String
  date                  DateTime  @db.Date
  week                  String?
  customerCountAffected Int       @default(0)
  cartonsAffected       Int       @default(0)
  unitPrice             Float?
  amount                Float?
  alternativeAvailable  Boolean   @default(false)
  alternativeProduct    String?
  isTrueStockout        Boolean   @default(false)
  notes                 String?
  createdAt             DateTime  @default(now())

  assignment            DailyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sku                   SkuCatalog @relation(fields: [skuId], references: [id])
  route                 Route     @relation(fields: [routeId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([routeId])
  @@index([week])
  @@map("missing_items")
}

model Return {
  id              String        @id @default(cuid())
  driverShiftId   String
  skuId           String
  type            ReturnReason
  quantity        Int           @default(0)
  price           Float         @default(0)
  amount          Float         @default(0)
  reason          String?
  comments        String?
  createdAt       DateTime      @default(now())

  driverShift     DriverShift   @relation(fields: [driverShiftId], references: [id], onDelete: Cascade)
  sku             SkuCatalog    @relation(fields: [skuId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("returns")
}

model FleetDaily {
  id                  String    @id @default(cuid())
  date                DateTime  @db.Date
  vehicleId           String
  expectedAvailable   Int       @default(0)
  actualAvailable     Int       @default(0)
  inGarage            Int       @default(0)
  garageReason        String?
  workshopTat         String?
  theftReport         Int       @default(0)
  theftReason         String?
  preDispatchInspection Boolean @default(false)
  inspectionReason    String?
  createdAt           DateTime  @default(now())

  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([date, vehicleId])
  @@map("fleet_daily")
}

model VehicleInspection {
  id          String        @id @default(cuid())
  vehicleId   String
  date        DateTime      @db.Date
  type        InspectionType
  item        String
  status      String?
  reason      String?
  createdAt   DateTime      @default(now())

  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("vehicle_inspections")
}

model PricingSurvey {
  id                String    @id @default(cuid())
  date              DateTime  @db.Date
  routeId           String
  salesRepId        String
  skuId             String
  competitorName    String?
  competitorPrice   Float
  khelPrice         Float
  difference        Float     @default(0)
  createdAt         DateTime  @default(now())

  route             Route     @relation(fields: [routeId], references: [id])
  salesRep          SalesRep  @relation(fields: [salesRepId], references: [id])
  sku               SkuCatalog @relation(fields: [skuId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("pricing_surveys")
}

model Challenge {
  id          String    @id @default(cuid())
  date        DateTime  @default(now())
  gap         String
  whatAction  String?
  who         String?
  when        DateTime?
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("challenges")
}

model InventoryCount {
  id              String    @id @default(cuid())
  store           String
  countDate       DateTime  @db.Date
  skuId           String
  category        String?
  physicalQty     Int       @default(0)
  systemQty       Int       @default(0)
  variance        Int       @default(0)
  unitPrice       Float     @default(0)
  stockValue      Float     @default(0)
  lastStocked     DateTime?
  expiryDate      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())

  sku             SkuCatalog @relation(fields: [skuId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("inventory_counts")
}

model ShareToken {
  id          String   @id @default(cuid())
  token       String   @unique
  reportType  String
  params      Json
  createdBy   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("share_tokens")
}

model CashierAccount {
  id                      String    @id @default(cuid())
  repId                   String    @unique
  status                  String    @default("open") // 'open' | 'blocked'
  currentBalance          Float     @default(0)
  creditReferenceAmount   Float     @default(0)
  autoBlockThresholdPct   Float     @default(25)
  lastOpenedAt            DateTime?
  lastBlockedAt           DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  rep                     SalesRep  @relation(fields: [repId], references: [id], onDelete: Cascade)
  creditSales             CreditSale[]
  blockEvents             AccountBlockEvent[]
  unblockRequests         AccountUnblockRequest[]
  openLogs                AccountOpenLog[]
  alerts                  AccountAlert[]


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@map("cashier_accounts")
}

model CreditSale {
  id              String    @id @default(cuid())
  accountId       String
  retailerName    String
  routeId         String
  amount          Float
  incurredDate    DateTime  @db.Date
  settled         Boolean   @default(false)
  settledDate     DateTime?
  settledAmount   Float?
  createdAt       DateTime  @default(now())

  account         CashierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  route           Route          @relation(fields: [routeId], references: [id])
  blockEvents     AccountBlockEvent[]


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([settled])
  @@map("credit_sales")
}

model AccountBlockEvent {
  id                    String    @id @default(cuid())
  accountId             String
  blockedAt             DateTime  @default(now())
  blockType             String    // 'manual' | 'auto'
  blockedByCashierId    String?
  reason                String?
  balanceAtTrigger      Float?
  pctAtTrigger          Float?
  relatedCreditSaleId   String?
  unblockedAt           DateTime?
  unblockReason         String?   // 'debt_settled' | 'cashier_override'

  account               CashierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  blockedByCashier      User?          @relation("BlockEventCashier", fields: [blockedByCashierId], references: [id])
  relatedCreditSale     CreditSale?    @relation(fields: [relatedCreditSaleId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@map("account_block_events")
}

model AccountUnblockRequest {
  id                    String    @id @default(cuid())
  accountId             String
  requestedByRepId      String
  requestedAt           DateTime  @default(now())
  routeOrRetailerRef    String
  amount                Float
  justification         String
  status                String    @default("pending") // 'pending' | 'approved' | 'rejected'
  reviewedByCashierId   String?
  reviewedAt            DateTime?
  letterPdfUrl          String?

  account               CashierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requestedByRep        User           @relation("RequestByRep", fields: [requestedByRepId], references: [id])
  reviewedByCashier     User?          @relation("ReviewRequestCashier", fields: [reviewedByCashierId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([status])
  @@map("account_unblock_requests")
}

model AccountOpenLog {
  id                    String    @id @default(cuid())
  accountId             String
  logDate               DateTime  @db.Date
  scheduledOpenTime     DateTime?
  actualOpenTime        DateTime?
  delayMinutes          Float     @default(0)
  createdAt             DateTime  @default(now())

  account               CashierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@map("account_open_log")
}

model AccountAlert {
  id                          String    @id @default(cuid())
  accountId                   String
  alertType                   String    @default("auto_block")
  triggeredAt                 DateTime  @default(now())
  balanceAtTrigger            Float?
  pctAtTrigger                Float?
  acknowledged                Boolean   @default(false)
  acknowledgedByCashierId     String?
  acknowledgedAt              DateTime?

  account                     CashierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  acknowledgedByCashier       User?          @relation("AlertCashier", fields: [acknowledgedByCashierId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([acknowledged])
  @@map("account_alerts")
}

model WeeklyProfitabilitySnapshot {
  id                            String    @id @default(cuid())
  routeId                       String
  weekStart                     DateTime  @db.Date
  tonnageDelivered              Float?
  sales                         Float?
  cogs                          Float?
  fuelVehicleCost               Float?
  returnsCost                   Float?
  costOfSales                   Float?
  profit                        Float?
  missingItemsOpportunityCost   Float?
  cogsStatus                    String    @default("pending_pricing") // "available" | "pending_pricing"
  frozenAt                      DateTime  @default(now())

  route                         Route     @relation(fields: [routeId], references: [id])


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([routeId, weekStart])
  @@map("weekly_profitability_snapshots")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   // "account_blocked" | "unblock_approved" | "unblock_request" | "report_reminder" | "assignment_change" | "route_change" | "shift_change" | "weekly_report_ready" | "stockout_alert" | "message"
  link      String?
  read      Boolean  @default(false)
  pushed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // "create" | "update" | "delete" | "block" | "unblock" | "approve" | "reject"
  entityType String   // "user" | "driver" | "vehicle" | "assignment" | "account_block" | "unblock_request" | "challenge"
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())


  // ── tenancy (phase 1: nullable, unenforced) ──
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  type    String  // "report_reminder" | "account_blocked" | "unblock_approved" | "unblock_request" | "assignment_change" | "stockout_alert"
  enabled Boolean @default(true)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}

// ─────────────────────────────────────────────────────────
// Tenancy + Route-Mapping module foundation (phase 1)
// See docs/TENANT_MIGRATION_PLAN.md
// ─────────────────────────────────────────────────────────

model Tenant {
  id               String   @id @default(cuid())
  externalClientId String?  @unique // PlayMax clients.id — set at module activation
  name             String   @unique
  status           String   @default("active") // active | paused | disabled
  ingestUrl        String? // PlayMax module ingest endpoint, per tenant override
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  routeGroups              RouteGroup[]
  routes                   Route[]
  salesReps                SalesRep[]
  salesRepRoutes           SalesRepRoute[]
  drivers                  Driver[]
  vehicles                 Vehicle[]
  vehicleFixedCosts        VehicleFixedCost[]
  vehicleMaintenanceEvents VehicleMaintenanceEvent[]
  payrollCosts             PayrollCost[]
  skuCatalog               SkuCatalog[]
  dailyAssignments         DailyAssignment[]
  salesRepShifts           SalesRepShift[]
  driverShifts             DriverShift[]
  orders                   Order[]
  orderLines               OrderLine[]
  deliveryStops            DeliveryStop[]
  missingItems             MissingItem[]
  returns                  Return[]
  fleetDaily               FleetDaily[]
  vehicleInspections       VehicleInspection[]
  pricingSurveys           PricingSurvey[]
  challenges               Challenge[]
  inventoryCounts          InventoryCount[]
  shareTokens              ShareToken[]
  cashierAccounts          CashierAccount[]
  creditSales              CreditSale[]
  accountBlockEvents       AccountBlockEvent[]
  accountUnblockRequests   AccountUnblockRequest[]
  accountOpenLogs          AccountOpenLog[]
  accountAlerts            AccountAlert[]
  weeklyProfitabilitySnapshots WeeklyProfitabilitySnapshot[]
  auditLogs                AuditLog[]

  devices          Device[]
  syncOperations   SyncOperation[]
  locationEvents   RepLocationEvent[]

  @@map("tenants")
}

// Field device registry (review §14) — revocation, versioning, push.
model Device {
  id         String    @id @default(cuid())
  tenantId   String
  repId      String? // owning sales rep, if assigned
  deviceId   String    @unique // client-generated stable UUID
  platform   String? // "android" | "ios"
  osVersion  String?
  appVersion String?
  pushToken  String?
  status     String    @default("active") // active | revoked
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("devices")
}

// Idempotent offline-sync ledger (review §7).
// PK is the CLIENT-generated operation UUID: a retried upload collides on the
// primary key and the server answers with the original result — never a dup.
model SyncOperation {
  id            String   @id // operation_id from device
  tenantId      String
  repId         String?
  deviceId      String?
  entityType    String // "visit" | "order" | "location_batch" | ...
  entityId      String?
  operationType String   @default("create") // create | update
  payload       Json     @default("{}")
  resultRef     Json? // server-assigned ids after processing
  syncedAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, syncedAt])
  @@index([repId])
  @@map("sync_operations")
}

// GPS breadcrumbs (review §8) — dedicated high-volume subsystem.
// Never joined casually; retention policy + aggregation land in phase 4.
model RepLocationEvent {
  id              String   @id @default(cuid())
  tenantId        String
  repId           String
  routeId         String?
  latitude        Float
  longitude       Float
  accuracyMeters  Float?
  speedKph        Float?
  headingDeg      Float?
  recordedAt      DateTime // device clock when fix was taken
  deviceTimestamp DateTime? // raw device timestamp as sent
  receivedAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, repId, recordedAt])
  @@index([routeId, recordedAt])
  @@map("rep_location_events")
}
